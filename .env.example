# =============================================================================
# ClaimSense AI — Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# AWS / Bedrock
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<your-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-secret-access-key>
# Optional: only needed when using assumed roles / SSO
AWS_SESSION_TOKEN=<your-session-token>

# Tiered model routing (ARCHITECTURE.md §4)
# Stage 1 Triage + Stage 2 Evidence  →  fast / cheap model
BEDROCK_FAST_MODEL_ID=bedrock/anthropic.claude-3-5-haiku-20241022-v1:0
# Stage 3 Policy / Money step        →  reasoning model
BEDROCK_REASONING_MODEL_ID=bedrock/anthropic.claude-3-5-sonnet-20241022-v2:0
# Embeddings for pgvector policy KB  →  Amazon Titan Text v2
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# -----------------------------------------------------------------------------
# PostgreSQL (matches docker-compose.yml defaults)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://claimsense:claimsense_password@localhost:5432/claimsensedb
# Sync URL used by Alembic migrations only
DATABASE_URL_SYNC=postgresql://claimsense:claimsense_password@localhost:5432/claimsensedb

POSTGRES_USER=claimsense
POSTGRES_PASSWORD=claimsense_password
POSTGRES_DB=claimsensedb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# FastAPI / API Gateway
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Set to "production" to disable /docs and /redoc
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# JWT / Identity (DEC-012: HS256 fallback when Cognito is unavailable)
# -----------------------------------------------------------------------------
# Secret used to sign and verify HS256 JWTs in the local/fallback path
JWT_SECRET=<change-me-to-a-long-random-string>
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=3600

# AWS Cognito (production path — leave blank to use HS256 fallback)
COGNITO_USER_POOL_ID=<us-east-1_xxxxxxxxx>
COGNITO_APP_CLIENT_ID=<your-cognito-app-client-id>
COGNITO_REGION=us-east-1

# -----------------------------------------------------------------------------
# Business Rules & Thresholds (ARCHITECTURE.md §6.1 / DEC-009)
# -----------------------------------------------------------------------------
# Maximum loss amount eligible for Straight-Through Processing auto-approval
STP_MAX_LOSS_USD=3000.00
# Fraud score at or above this routes to SIU
FRAUD_SIU_THRESHOLD=0.70
# Fraud score at or above this (but below SIU) routes to MANUAL_REVIEW
FRAUD_REVIEW_THRESHOLD=0.35
# Total-loss ratio at or above this routes to appraiser (DEC-009)
TOTAL_LOSS_RATIO_THRESHOLD=0.75
# Statutory prompt-payment clocks (calendar days)
STATUTORY_ACK_DAYS=15
STATUTORY_DECISION_DAYS=30
# Duplicate claim detection window (hours)
DUPLICATE_CLAIM_WINDOW_HOURS=72

# -----------------------------------------------------------------------------
# AWS S3 — Document Object Store
# -----------------------------------------------------------------------------
S3_BUCKET_NAME=claimsense-docs
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# AWS ECR — Container Registry
# -----------------------------------------------------------------------------
ECR_REPOSITORY=claimsense/agents
ECR_REGION=us-east-1

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# OpenTelemetry collector endpoint (leave blank to disable tracing)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=claimsense-ai
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Evaluation Harness (ARCHITECTURE.md §9)
# -----------------------------------------------------------------------------
# Minimum pass rate for CI smoke gate (20 cases)
EVAL_SMOKE_MIN_PASS=0.90
# Minimum pass rate for release golden gate (150 cases)
EVAL_GOLDEN_MIN_PASS=0.95
# Path to the benchmark dataset relative to codebase/
EVAL_BENCHMARK_PATH=evaluation/benchmark_dataset.json
